# Copy this file to .env and fill in real values. Never commit .env itself.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=graphtriage
MYSQL_USER=graphtriage_user
MYSQL_PASSWORD=changeme_user
MYSQL_HOST=mysql
MYSQL_PORT=3306

# ---- Neo4j ----
NEO4J_AUTH=neo4j/changeme_neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_neo4j

# ---- Spring Boot (ticketing-service) ----
SPRING_PORT=8080
JWT_SECRET=change_this_to_a_long_random_string_before_using_real_auth

# ---- FastAPI (inference-service) ----
INFERENCE_PORT=8000
