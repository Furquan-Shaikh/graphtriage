ticketing-service/target/
ticketing-service/*.log
*.class

# Python
inference-service/__pycache__/
inference-service/**/__pycache__/
inference-service/.venv/
inference-service/venv/
inference-service/*.egg-info/
*.pyc

# IDE
.idea/
.vscode/
